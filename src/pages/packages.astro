    ],
    icon: 'explore',
    highlight: true,
  },
  {
    name: '3 Days 2 Nights',
    duration: 'VW Safari — Undisan Village',
    description: 'An iconic journey aboard a vintage VW Safari, exploring Balinese culture and authentic village life in Undisan — complete with temple visits, cooking, and trekking.',
    days: [
      {
        label: 'Day 1',
        items: [
          'Pick-up at 09.00 by VW Safari → Penglipuran Village & Pura Kehen (11th-century temple)',
          'Lunch at local restaurant with freshwater fish',
          'Arrival at D\'Karang — group cooking class for dinner',
          'Overnight at D\'Karang',
        ],
      },
      {
        label: 'Day 2',
        items: [
          'Traditional breakfast',
          'Village trekking: Balinese traditional compound, local primary school visit, Tangkup Waterfall (±25 m)',
          'Traditional lunch',
          'Afternoon: canang sari (Balinese Hindu offering) making',
          'Traditional coconut oil making (from fresh coconut to finished oil)',
          'Traditional dinner & overnight',
        ],
      },
      {
        label: 'Day 3',
        items: [
          'Traditional breakfast',
          'Choose one: Eco Cycling Tour (pine forest → Luwak coffee → orange orchard → Tukad Cepung Waterfall) OR Flying Fox (Zipline)',
          'Transfer out',
        ],
      },
    ],
    icon: 'directions_car',
    highlight: false,
  },
  {
    name: '3 Days 2 Nights',
    duration: 'Guliang & D\'Karang',
    description: 'Combines spiritual healing in Guliang with nature, culture, and adventure in Undisan — plus visits to Besakih Temple and the Kintamani highlands.',
    days: [
      {
        label: 'Day 1',
        items: [
          'Pick-up at 09.00 by VW Safari (from Ubud or Sanur area)',
