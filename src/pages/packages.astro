---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const packages = [
  {
    name: 'Standard Garden Retreat',
    duration: 'Perfect for Solos or Couples',
    price: 'From IDR 450.000 / Night',
    description:
      'Experience the tranquility of Undisan in our cozy standard rooms. Featuring lush garden views and traditional Balinese architecture.',
    features: [
      '24m² Room Size',
      'Choice of Twin or Double Bed',
      'Garden View Terrace',
      'Daily Halal Breakfast',
      'Free WiFi Access',
    ],
    icon: 'park',
    highlight: false,
  },
  {
    name: 'Deluxe Pool Escape',
    duration: 'Our Most Popular Choice',
    price: 'From IDR 750.000 / Night',
    description:
      'Step directly from your room into the refreshing waters of our outdoor pool. These spacious rooms offer the ultimate relaxation.',
    features: [
      '30m² Room Size',
      'Pool Access / Garden View',
      '1 Single + 1 Double Bed',
      'Private Terrace / Balcony',
      'Air Conditioning & Hot Water',
      'Daily Halal Breakfast',
      'Poolside Lounging Area',
    ],
    icon: 'pool',
    highlight: true,
  },
  {
    name: 'Budget Nature Stay',
    duration: 'Essential & Comfortable',
    price: 'From IDR 350.000 / Night',
    description:
      'A comfortable base for your Bangli adventures. Our budget rooms provide everything you need for a restful night in nature.',
    features: [
      '28m² Room Size',
      'Large Double Bed',
      'Lush Garden Surroundings',
      'Free WiFi Access',
      'Outdoor Seating Area',
      'Complimentary Bottled Water',
    ],
    icon: 'eco',
    highlight: false,
  },
];
---

<Layout title="Packages | D'karang Eco Lodge">
  <Navbar activeLink="packages" />

  <!-- Page Hero -->
  <header class="pt-32 md:pt-40 pb-12 px-6 md:px-12 bg-surface-container-low">
    <div class="max-w-7xl mx-auto">
      <span class="text-primary uppercase tracking-[0.2em] text-xs font-semibold mb-4 block animate-hero-title">
        Curated Stays
      </span>
      <h1 class="font-headline text-4xl md:text-6xl font-bold text-on-surface tracking-tight animate-hero-body">
        Choose Your Sanctuary
      </h1>
      <p class="text-on-surface-variant text-base md:text-lg mt-4 max-w-xl animate-hero-cta">
        Each package is thoughtfully designed to immerse you in the beauty, culture, and tranquility of Undisan Village.
      </p>
    </div>
  </header>

  <!-- Packages Grid -->
  <section class="py-20 px-6 md:px-12 bg-surface">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
      {packages.map((pkg, index) => (
        <div
          class={`relative rounded-2xl flex flex-col overflow-hidden shadow-md transition-transform hover:-translate-y-1 duration-300 ${pkg.highlight ? 'ring-2 ring-primary' : ''}`}
          data-aos="fade-up"
          data-aos-delay={index * 150}
        >
          {pkg.highlight && (
            <div class="bg-primary text-on-primary text-xs font-label uppercase tracking-widest text-center py-2 px-4">
              Most Popular
            </div>
          )}
          <div class="bg-surface-container-lowest p-8 flex flex-col flex-1">
            <!-- Icon & Name -->
            <div class="w-14 h-14 rounded-full bg-primary-container flex items-center justify-center mb-6">
              <span class="material-symbols-outlined text-on-primary-container text-2xl font-light">
                {pkg.icon}
              </span>
            </div>
            <h2 class="font-headline text-2xl font-bold text-on-surface mb-1">{pkg.name}</h2>
            <p class="text-secondary text-sm font-label mb-4">{pkg.duration}</p>
            <p class="text-on-surface-variant text-sm leading-relaxed mb-6">{pkg.description}</p>

            <!-- Features -->
            <ul class="space-y-2 mb-8 flex-1">
              {pkg.features.map((f) => (
                <li class="flex items-start gap-2 text-sm text-on-surface-variant">
                  <span class="material-symbols-outlined text-primary text-base mt-0.5 shrink-0">check_circle</span>
                  {f}
                </li>
              ))}
            </ul>

            <!-- Price & CTA -->
            <div class="border-t border-outline-variant/40 pt-6">
              <p class="font-headline text-xl text-primary font-bold mb-4">{pkg.price}</p>
              <a
                href={`https://wa.me/6281238211110?text=Halo%20D'karang%20Eco%20Lodge,%20saya%20tertarik%20dengan%20paket%20${encodeURIComponent(pkg.name)}.`}
                target="_blank"
                class={`block w-full text-center rounded-full px-6 py-3 text-sm font-label font-semibold transition-opacity hover:opacity-90 ${pkg.highlight ? 'bg-linear-to-r from-primary to-primary-container text-on-primary' : 'border-2 border-primary text-primary hover:bg-primary hover:text-on-primary'}`}
              >
                Enquire Now
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Custom Package CTA -->
  <section class="py-20 bg-surface-container-low px-6 text-center" data-aos="fade-up">
    <span class="material-symbols-outlined text-primary-container text-5xl mb-4 block">tune</span>
    <h2 class="font-headline text-3xl md:text-4xl text-on-surface mb-4">
      Need a Custom Package?
    </h2>
    <p class="text-on-surface-variant mb-8 max-w-md mx-auto">
      We're happy to tailor an experience around your group, dates, and preferences. Reach out and we'll create something just for you.
    </p>
    <a
      href="https://wa.me/6281238211110?text=Halo%20D'karang%20Eco%20Lodge,%20saya%20ingin%20bertanya%20tentang%20paket%20kustom."
      target="_blank"
      class="inline-block bg-linear-to-r from-primary to-primary-container text-on-primary font-label text-sm px-8 py-4 rounded-full hover:opacity-90 transition-opacity"
    >
      Contact Us
    </a>
  </section>

  <Footer />
</Layout>
