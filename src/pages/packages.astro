          'Cycling: pine forest → knife smith → orange orchard Landih Village',
          'Lunch at D\'Karang',
          'Check out, transfer to next destination',
        ],
      },
    ],
    icon: 'forest',
    highlight: false,
  },
  {
    name: '4 Days 3 Nights',
    duration: 'New D\'Karang Package',
    description: 'A fresh itinerary with a scenic final-day transfer via Teraz Agro Coffee Plantation — and an optional Bali Swing to close out the adventure.',
    days: [
      {
        label: 'Day 1',
        items: [
          'Arrival in Bali, transfer to Undisan Village',
          'Welcome drink, dinner & overnight',
        ],
      },
      {
        label: 'Day 2',
        items: [
          'Breakfast → VW Safari to Guliang Village: spiritual healing & blessing, canang, farming',
          'Lunch → Pura Kehen',
          'Return to D\'Karang — trekking: traditional compound, rice fields, Tangkup Waterfall',
          'Laklak cake making → Sate Lilit cooking class',
          'Dinner & overnight',
        ],
      },
      {
        label: 'Day 3',
        items: [
          'Traditional breakfast',
          'Cycling: pine forest → knife smith → local orange orchard',
          'Lunch with views of rice fields and Gunung Agung',
          'Visit Pura Besakih & Kintamani',
          'Return to D\'Karang, dinner & overnight',
        ],
      },
      {
        label: 'Day 4',
        items: [
          'Traditional breakfast',
          'Transfer out with a stop at Teraz Agro Coffee Plantation',
          'Optional: Bali Swing',
          'Transfer to next destination',
        ],
      },
    ],
    icon: 'coffee',
    highlight: false,
  },
];
---

<Layout title="Packages | D'Karang Eco Lodge">
  <Navbar activeLink="packages" />

  <!-- Page Hero -->
  <header class="pt-32 md:pt-40 pb-12 px-6 md:px-12 bg-surface-container-low">
    <div class="max-w-7xl mx-auto">
      <span class="text-primary uppercase tracking-[0.2em] text-xs font-semibold mb-4 block animate-hero-title">
        Tour Packages
      </span>
      <h1 class="font-headline text-4xl md:text-6xl font-bold text-on-surface tracking-tight animate-hero-body">
        Choose Your Experience
      </h1>
      <p class="text-on-surface-variant text-base md:text-lg mt-4 max-w-xl animate-hero-cta">
        Each package is thoughtfully designed to immerse you in the beauty, culture, and authentic life of Undisan Village.
      </p>
    </div>
  </header>

  <!-- Packages Grid -->
  <section class="py-20 px-6 md:px-12 bg-surface">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
      {packages.map((pkg, index) => (
        <div
          class={`relative rounded-2xl flex flex-col overflow-hidden shadow-md transition-transform hover:-translate-y-1 duration-300 ${pkg.highlight ? 'ring-2 ring-primary' : ''}`}
          data-aos="fade-up"
          data-aos-delay={index * 120}
        >
          {pkg.highlight && (
            <div class="bg-primary text-on-primary text-xs font-label uppercase tracking-widest text-center py-2 px-4">
              Most Popular
            </div>
          )}
          <div class="bg-surface-container-lowest p-6 flex flex-col flex-1">
            <div class="flex items-start gap-4 mb-5">
              <div class="w-12 h-12 rounded-full bg-primary-container flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-on-primary-container text-xl font-light">
                  {pkg.icon}
                </span>
              </div>
              <div>
                <h2 class="font-headline text-xl font-bold text-on-surface leading-tight mb-1">{pkg.name}</h2>
                <p class="text-secondary text-xs font-label">{pkg.duration}</p>
              </div>
            </div>
            <p class="text-on-surface-variant text-sm leading-relaxed mb-5">{pkg.description}</p>

            <!-- Itinerary -->
            <div class="flex-1 mb-6 flex flex-col gap-5">
              {pkg.days.map((day) => (
                <div>
                  <p class="font-label text-[10px] text-primary uppercase tracking-widest mb-2.5">{day.label}</p>
                  <ul class="flex flex-col gap-1.5">
                    {day.items.map((item) => (
                      <li class="flex items-start gap-2 text-xs text-on-surface-variant leading-snug">
                        <span class="material-symbols-outlined text-primary text-sm mt-0.5 shrink-0">arrow_right</span>
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>

            <!-- CTA -->
            <div class="border-t border-outline-variant/40 pt-5 mt-auto">
              <a
                href={`https://wa.me/6281238211110?text=Hello%20D'Karang%20Eco%20Lodge,%20I'm%20interested%20in%20the%20${encodeURIComponent(pkg.name + ' — ' + pkg.duration)}%20package.`}
                target="_blank"
                class={`block w-full text-center rounded-full px-5 py-2.5 text-sm font-label font-semibold transition-opacity hover:opacity-90 ${pkg.highlight ? 'bg-linear-to-r from-primary to-primary-container text-on-primary' : 'border-2 border-primary text-primary hover:bg-primary hover:text-on-primary'}`}
              >
                Enquire Now
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Custom Package CTA -->
  <section class="py-20 bg-surface-container-low px-6 text-center" data-aos="fade-up">
    <span class="material-symbols-outlined text-primary-container text-5xl mb-4 block">tune</span>
    <h2 class="font-headline text-3xl md:text-4xl text-on-surface mb-4">
      Need a Custom Package?
    </h2>
    <p class="text-on-surface-variant mb-8 max-w-md mx-auto">
      We're happy to tailor an experience around your group, dates, and preferences. Reach out and we'll create something just for you.
    </p>
    <a
      href="https://wa.me/6281238211110?text=Hello%20D'Karang%20Eco%20Lodge,%20I'd%20like%20to%20enquire%20about%20a%20custom%20package."
      target="_blank"
      class="inline-block bg-linear-to-r from-primary to-primary-container text-on-primary font-label text-sm px-8 py-4 rounded-full hover:opacity-90 transition-opacity"
    >
      Contact Us
    </a>
  </section>

  <Footer />
</Layout>
