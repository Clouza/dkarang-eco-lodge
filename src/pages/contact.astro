---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const contactInfo = [
  { icon: 'location_on', label: 'Address', value: 'Jalan Raya Besakih, 80671 Undisan, Bangli, Bali, Indonesia' },
  { icon: 'call', label: 'Phone', value: '+62 812-3456-7890' },
  { icon: 'mail', label: 'Email', value: 'hello@dkaranglodge.com' },
  { icon: 'schedule', label: 'Reception Hours', value: 'Daily, 08.00 – 20.00 WITA' },
];
---

<Layout title="Contact | D'karang Eco Lodge">
  <Navbar activeLink="contact" />

  <!-- Page Hero -->
  <header class="pt-32 md:pt-40 pb-12 px-6 md:px-12 bg-surface-container-low">
    <div class="max-w-7xl mx-auto">
      <span class="text-primary uppercase tracking-[0.2em] text-xs font-semibold mb-4 block animate-hero-title">
        Get in Touch
      </span>
      <h1 class="font-headline text-4xl md:text-6xl font-bold text-on-surface tracking-tight animate-hero-body">
        We'd Love to Hear From You
      </h1>
      <p class="text-on-surface-variant text-base md:text-lg mt-4 max-w-xl animate-hero-cta">
        Whether you're planning a stay, requesting a custom package, or simply have a question — our team is here to help.
      </p>
    </div>
  </header>

  <!-- Main Content -->
  <section class="py-20 px-6 md:px-12 bg-surface">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">

      <!-- Contact Form -->
      <div data-aos="fade-right">
        <h2 class="font-headline text-3xl font-bold text-on-surface mb-8">Send Us a Message</h2>
        <form class="space-y-5" novalidate>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-label text-on-surface-variant mb-1.5" for="name">
                Full Name
              </label>
              <input
                id="name"
                name="name"
                type="text"
                placeholder="Your name"
                class="w-full px-4 py-3 rounded-xl border border-outline-variant bg-surface-container-lowest text-on-surface text-sm placeholder:text-on-surface-variant/50 focus:outline-none focus:ring-2 focus:ring-primary transition"
              />
            </div>
            <div>
              <label class="block text-sm font-label text-on-surface-variant mb-1.5" for="email">
                Email Address
              </label>
              <input
                id="email"
                name="email"
                type="email"
                placeholder="your@email.com"
                class="w-full px-4 py-3 rounded-xl border border-outline-variant bg-surface-container-lowest text-on-surface text-sm placeholder:text-on-surface-variant/50 focus:outline-none focus:ring-2 focus:ring-primary transition"
              />
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-label text-on-surface-variant mb-1.5" for="checkin">
                Check-in Date
              </label>
              <input
                id="checkin"
                name="checkin"
                type="date"
                class="w-full px-4 py-3 rounded-xl border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary transition"
              />
            </div>
            <div>
              <label class="block text-sm font-label text-on-surface-variant mb-1.5" for="guests">
                Number of Guests
              </label>
              <select
                id="guests"
                name="guests"
                class="w-full px-4 py-3 rounded-xl border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary transition"
              >
                <option value="">Select guests</option>
                <option value="1">1 Guest</option>
                <option value="2">2 Guests</option>
                <option value="3">3 Guests</option>
                <option value="4">4 Guests</option>
                <option value="5+">5+ Guests</option>
              </select>
            </div>
          </div>
          <div>
            <label class="block text-sm font-label text-on-surface-variant mb-1.5" for="package">
              Interested In
            </label>
            <select
              id="package"
              name="package"
              class="w-full px-4 py-3 rounded-xl border border-outline-variant bg-surface-container-lowest text-on-surface text-sm focus:outline-none focus:ring-2 focus:ring-primary transition"
            >
              <option value="">Select a package</option>
              <option value="weekend">Weekend Retreat</option>
              <option value="cultural">Cultural Immersion</option>
              <option value="family">Family Sanctuary</option>
              <option value="custom">Custom Package</option>
              <option value="general">General Enquiry</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-label text-on-surface-variant mb-1.5" for="message">
              Message
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              placeholder="Tell us about your plans or any questions you have..."
              class="w-full px-4 py-3 rounded-xl border border-outline-variant bg-surface-container-lowest text-on-surface text-sm placeholder:text-on-surface-variant/50 focus:outline-none focus:ring-2 focus:ring-primary transition resize-none"
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full bg-linear-to-r from-primary to-primary-container text-on-primary font-label font-semibold text-sm px-8 py-4 rounded-full hover:opacity-90 transition-opacity"
          >
            Send Message
          </button>
        </form>
      </div>

      <!-- Contact Info + Map -->
      <div class="space-y-10" data-aos="fade-left" data-aos-delay="150">
        <div>
          <h2 class="font-headline text-3xl font-bold text-on-surface mb-8">Lodge Information</h2>
          <ul class="space-y-6">
            {contactInfo.map((item) => (
              <li class="flex items-start gap-4">
                <div class="w-11 h-11 rounded-full bg-primary-container flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined text-on-primary-container text-xl font-light">
                    {item.icon}
                  </span>
                </div>
                <div>
                  <p class="text-xs font-label uppercase tracking-widest text-on-surface-variant mb-0.5">
                    {item.label}
                  </p>
                  <p class="text-on-surface text-sm font-medium">{item.value}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <!-- Map placeholder -->
        <div class="rounded-2xl overflow-hidden h-64 bg-surface-container-high relative flex items-center justify-center">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3948.3!2d115.3662!3d-8.3984!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2dd21b0e7a97c6e7%3A0x1!2sJl.+Raya+Besakih%2C+Undisan%2C+Tembuku%2C+Bangli%2C+Bali!5e0!3m2!1sen!2sid!4v1"
            class="w-full h-full border-0"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="D'karang Eco Lodge location"
          ></iframe>
        </div>

        <!-- Quick note -->
        <div class="bg-surface-container-low rounded-xl p-6 border border-outline-variant/30">
          <p class="text-sm text-on-surface-variant leading-relaxed">
            <span class="font-semibold text-primary">Response time:</span> We typically respond within 24 hours. For urgent enquiries, please call us directly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
