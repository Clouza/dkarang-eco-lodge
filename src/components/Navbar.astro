---
interface Props {
  activeLink?: 'lodge' | 'packages' | 'gallery' | 'contact' | 'about';
}

const { activeLink } = Astro.props;

const links = [
  { label: 'Lodge', href: '/', key: 'lodge' },
  { label: 'About', href: '/about', key: 'about' },
  { label: 'Packages', href: '/packages', key: 'packages' },
  { label: 'Gallery', href: '/gallery', key: 'gallery' },
  { label: 'Contact', href: '/contact', key: 'contact' },
];
---

<nav class="fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-md border-b border-outline-variant/30">
  <div class="flex justify-between items-center px-6 md:px-8 py-4 max-w-screen-2xl mx-auto">
    <!-- Logo -->
    <a class="font-headline text-xl font-bold text-primary tracking-tight" href="/">
      D'karang Lodge
    </a>

    <!-- Desktop links -->
    <div class="hidden md:flex gap-8 items-center font-label tracking-wide text-sm uppercase">
      {links.map((link) => (
        <a
          class={`pb-0.5 transition-colors duration-300 ${
            activeLink === link.key
              ? 'text-primary border-b-2 border-primary font-bold'
              : 'text-on-surface-variant hover:text-primary'
          }`}
          href={link.href}
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Desktop CTA -->
    <a
      href="https://wa.me/6281238211110?text=Halo%20D'karang%20Eco%20Lodge,%20saya%20ingin%20melakukan%20pemesanan%20kamar."
      target="_blank"
      class="bg-linear-to-r from-primary to-primary-container text-on-primary rounded-full px-6 py-2 text-sm font-semibold hover:opacity-90 transition-opacity hidden md:block"
    >
      Book Now
    </a>

    <!-- Mobile hamburger -->
    <button
      id="sidebar-open"
      class="md:hidden text-primary p-2 rounded-lg hover:bg-surface-container transition-colors"
      aria-label="Open navigation menu"
    >
      <span class="material-symbols-outlined text-3xl">menu</span>
    </button>
  </div>
</nav>

<!-- Backdrop -->
<div
  id="sidebar-backdrop"
  class="fixed inset-0 z-60 bg-black/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
></div>

<!-- Sidebar -->
<aside
  id="sidebar"
  class="fixed top-0 right-0 z-70 h-full w-72 bg-surface shadow-2xl flex flex-col translate-x-full transition-transform duration-300 ease-out md:hidden"
>
  <!-- Sidebar header -->
  <div class="flex justify-between items-center px-6 py-5 border-b border-outline-variant/30">
    <span class="font-headline text-lg font-bold text-primary">D'karang Lodge</span>
    <button
      id="sidebar-close"
      class="text-on-surface-variant hover:text-primary p-1 rounded-lg hover:bg-surface-container transition-colors"
      aria-label="Close navigation menu"
    >
      <span class="material-symbols-outlined text-2xl">close</span>
    </button>
  </div>

  <!-- Sidebar links -->
  <nav class="flex-1 px-4 py-6 flex flex-col gap-1 overflow-y-auto">
    {links.map((link) => (
      <a
        href={link.href}
        class={`flex items-center gap-3 px-4 py-3 rounded-xl font-label text-sm uppercase tracking-wide transition-colors duration-200 ${
          activeLink === link.key
            ? 'bg-primary-container/20 text-primary font-bold'
            : 'text-on-surface-variant hover:bg-surface-container hover:text-primary'
        }`}
      >
        {link.label}
      </a>
    ))}
  </nav>

  <!-- Sidebar CTA -->
  <div class="px-6 py-6 border-t border-outline-variant/30">
    <a
      href="https://wa.me/6281238211110?text=Halo%20D'karang%20Eco%20Lodge,%20saya%20ingin%20melakukan%20pemesanan%20kamar."
      target="_blank"
      class="block w-full text-center bg-linear-to-r from-primary to-primary-container text-on-primary rounded-full px-6 py-3 text-sm font-semibold hover:opacity-90 transition-opacity"
    >
      Book Now
    </a>
  </div>
</aside>

<script>
  const openBtn = document.getElementById('sidebar-open');
  const closeBtn = document.getElementById('sidebar-close');
  const sidebar = document.getElementById('sidebar');
  const backdrop = document.getElementById('sidebar-backdrop');

  function openSidebar() {
    sidebar?.classList.remove('translate-x-full');
    backdrop?.classList.remove('opacity-0', 'pointer-events-none');
    document.body.style.overflow = 'hidden';
  }

  function closeSidebar() {
    sidebar?.classList.add('translate-x-full');
    backdrop?.classList.add('opacity-0', 'pointer-events-none');
    document.body.style.overflow = '';
  }

  openBtn?.addEventListener('click', openSidebar);
  closeBtn?.addEventListener('click', closeSidebar);
  backdrop?.addEventListener('click', closeSidebar);

  // close on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSidebar();
  });
</script>
