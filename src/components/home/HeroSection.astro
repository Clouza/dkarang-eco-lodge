---
---

<section class="relative w-full h-screen min-h-150 flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0 z-0">
    <img
      alt="Lush green resort pool area surrounded by tropical trees and Balinese architecture"
      class="w-full h-full object-cover"
      src="images/hero-section.jpeg"
    />
    <div class="absolute inset-0 bg-black/50"></div>
  </div>
  <div class="relative z-10 text-center px-4 max-w-4xl mx-auto mt-20">
    <h1
      class="font-headline text-5xl md:text-7xl text-white mb-6 tracking-wide drop-shadow-lg animate-hero-title"
    >
      A Hidden Gem in Bangli, Bali
    </h1>
    <p
      class="font-body text-lg md:text-xl text-white/90 mb-10 max-w-2xl mx-auto animate-hero-body"
    >
      Where nature, culture, and authentic village life come together in perfect harmony.
    </p>
    <div class="animate-hero-cta">
      <a
        href="https://wa.me/6281238211110?text=Halo%20D'karang%20Eco%20Lodge,%20saya%20tertarik%20untuk%20menginap%20di%20sini."
        target="_blank"
        class="inline-block bg-linear-to-r from-primary to-primary-container text-on-primary font-label text-sm px-8 py-4 rounded-full hover:opacity-90 transition-opacity shadow-lg"
      >
        Book Now
      </a>
    </div>
  </div>
</section>
