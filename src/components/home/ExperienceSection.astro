---
const activities = [
  {
    icon: 'self_improvement',
    title: 'Spiritual Healing & Blessing',
    caption: 'Palm reading, positive energy transfer & blessing ceremony at Bale Dangin',
  },
  {
    icon: 'restaurant',
    title: 'Traditional Cooking Class',
    caption: 'Learn to make sate lilit, Balinese snacks & kue laklak',
  },
  {
    icon: 'volunteer_activism',
    title: 'Canang Sari Making',
    caption: 'Craft a sacred daily Balinese Hindu offering',
  },
  {
    icon: 'agriculture',
    title: 'Farming Activity',
    caption: 'Hands-on traditional Balinese farming experience',
  },
  {
    icon: 'water_drop',
    title: 'Coconut Oil Making',
    caption: 'From fresh coconut to finished oil — a traditional process',
  },
  {
    icon: 'music_note',
    title: 'Traditional Music & Dance',
    caption: 'Learn gamelan and move like a true Balinese',
  },
  {
    icon: 'hiking',
    title: 'Village Trekking',
    caption: 'Explore the village, rice fields, bamboo bridges & Tangkup Waterfall',
  },
  {
    icon: 'directions_bike',
    title: 'Eco Cycling Tour',
    caption: 'Ride through pine forests, coffee plantations & orange orchards',
  },
  {
    icon: 'paragliding',
    title: 'Flying Fox (Zipline)',
    caption: 'A rush of adrenaline high above the valley',
  },
  {
    icon: 'temple_hindu',
    title: 'Temple & Traditional House Visit',
    caption: 'Discover Pura Kehen, Pura Besakih & Balinese compound life',
  },
  {
    icon: 'local_cafe',
    title: 'Coffee Plantation Tour',
    caption: 'Visit Luwak coffee and local orange farms',
  },
];
---

<section class="py-16 md:py-24 bg-surface-container-high overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <h2
      class="font-headline text-3xl md:text-4xl text-primary mb-4 tracking-wide text-center"
      data-aos="fade-up"
    >
      Experiences
    </h2>
    <p class="font-body text-on-surface-variant text-center mb-12 max-w-xl mx-auto" data-aos="fade-up">
      Immerse yourself in the authentic rhythm of Balinese village life.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {activities.map((item, index) => (
        <div
          class="flex items-start gap-4 bg-surface-container-lowest rounded-2xl px-5 py-4 shadow-sm"
          data-aos="fade-up"
          data-aos-delay={index * 50}
        >
          <div class="w-10 h-10 rounded-full bg-primary-container flex items-center justify-center shrink-0 mt-0.5">
            <span class="material-symbols-outlined text-on-primary-container text-lg font-light">
              {item.icon}
            </span>
          </div>
          <div>
            <h3 class="font-headline text-sm font-bold text-on-surface leading-tight mb-1">{item.title}</h3>
            <p class="font-body text-xs text-on-surface-variant leading-snug">{item.caption}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
