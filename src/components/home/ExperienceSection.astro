---
const experiences = [
  {
    icon: 'pool',
    title: 'Outdoor Swimming Pool',
    description:
      'Take a dip year-round in our outdoor pool, set within a lush garden where birdsong and cool mountain air set the mood.',
  },
  {
    icon: 'restaurant',
    title: 'Halal Indonesian Cuisine',
    description:
      'Our on-site restaurant serves halal Indonesian dishes for breakfast, lunch, and dinner — fresh flavors rooted in local tradition.',
  },
  {
    icon: 'pedal_bike',
    title: 'Explore at Your Own Pace',
    description:
      'Hire a bicycle, arrange a car, or hop on our shuttle service. The road to Besakih, Tegallalang, and Ubud starts right at our door.',
  },
];
---

<section class="py-16 md:py-24 bg-surface-container-high overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <h2
      class="font-headline text-3xl md:text-4xl text-primary mb-16 tracking-wide text-center"
      data-aos="fade-up"
    >
      The D'karang Experience
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-x-8 gap-y-16">
      {experiences.map((item, index) => (
        <div
          class="bg-surface-container-lowest p-8 rounded-xl shadow-md relative mt-8"
          data-aos="fade-up"
          data-aos-delay={index * 150}
        >
          <div class="w-14 h-14 bg-primary-container rounded-full flex items-center justify-center absolute -top-7 left-6 shadow-sm">
            <span class="material-symbols-outlined text-on-primary-container text-2xl font-light">
              {item.icon}
            </span>
          </div>
          <h3 class="font-headline text-xl md:text-2xl text-on-surface mt-6 mb-3">{item.title}</h3>
          <p class="font-body text-sm md:text-base text-on-surface-variant leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
