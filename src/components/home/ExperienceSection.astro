---
const activities = [
  {
    slug: 'traditional-cooking-class',
    title: 'Traditional Cooking Class',
    caption: 'Learn to make sate lilit, Balinese soup, traditional snacks & vegetables',
  },
  {
    slug: 'canang-sari-making',
    title: 'Canang Sari Making',
    caption: 'Craft a sacred Balinese offering',
  },
  {
    slug: 'coconut-oil-making',
    title: 'Coconut Oil Making',
    caption: 'A hands-on traditional process',
  },
  {
    slug: 'traditional-music-dance',
    title: 'Traditional Music & Dance',
    caption: 'Move and play like a true Balinese',
  },
  {
    slug: 'rice-field-tracking',
    title: 'Rice Field Tracking',
    caption: 'Walk through lush green rice fields',
  },
  {
    slug: 'cycling-the-village',
    title: 'Cycling the Village',
    caption: 'Explore peaceful countryside paths',
  },
  {
    slug: 'waterfall-visit',
    title: 'Waterfall Visit',
    caption: 'Cool off in natural beauty',
  },
  {
    slug: 'temple-traditional-house-visit',
    title: 'Temple & Traditional House Visit',
    caption: 'Discover local life and spirituality',
  },
  {
    slug: 'coffee-plantation-tour',
    title: 'Coffee Plantation Tour',
    caption: 'Meet the coffee, from plant to cup',
  },
  {
    slug: 'flying-fox',
    title: 'Flying Fox',
    caption: 'A rush of adrenaline in the middle of nature',
  },
  {
    slug: 'meditation',
    title: 'Meditation',
    caption: 'Find stillness in the heart of the village',
  },
];
---

<section class="py-16 md:py-24 bg-surface-container-high overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <h2
      class="font-headline text-3xl md:text-4xl text-primary mb-4 tracking-wide text-center"
      data-aos="fade-up"
    >
      Experiences
    </h2>
    <p class="font-body text-on-surface-variant text-center mb-12 max-w-xl mx-auto" data-aos="fade-up">
      Immerse yourself in the authentic rhythm of Balinese village life.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {activities.map((item, index) => (
        <div
          class="relative rounded-xl overflow-hidden group aspect-4/3 bg-surface-container-highest flex items-center justify-center"
          data-aos="fade-up"
          data-aos-delay={index * 60}
        >
          {/* fallback text — visible only when image fails to load */}
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 p-5 text-center z-0">
            <span class="material-symbols-outlined text-on-surface-variant text-4xl font-light">image</span>
            <p class="font-headline text-base text-on-surface-variant leading-tight">{item.title}</p>
            <p class="font-body text-xs text-on-surface-variant/70 leading-snug">{item.caption}</p>
          </div>
          {/* image covers fallback when loaded */}
          <img
            src={`/images/activities/${item.slug}.jpg`}
            alt={item.title}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 z-10"
            onerror="this.style.display='none'"
          />
          {/* caption overlay on top of image */}
          <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/20 to-transparent flex flex-col justify-end p-5 z-20 pointer-events-none">
            <h3 class="font-headline text-lg text-white leading-tight mb-1">{item.title}</h3>
            <p class="font-body text-sm text-white/80 leading-snug">{item.caption}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
