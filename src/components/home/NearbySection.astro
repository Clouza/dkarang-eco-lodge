---
const attractions = [
  {
    icon: 'waves',
    name: 'Tukad Cepung Waterfall',
    distance: '3.3 km',
    description: "One of Bali's most unique waterfalls, famous for the sunbeams that shine through the cave opening.",
  },
  {
    icon: 'location_city',
    name: 'Bangli City Center',
    distance: '4.8 km',
    description: 'The capital of Bangli regency, offering local markets, traditional cuisine, and cultural landmarks.',
  },
  {
    icon: 'temple_buddhist',
    name: 'Pura Besakih',
    distance: '14.5 km',
    description: "The 'Mother Temple' of Bali, a grand complex of over 80 temples on the slopes of Mount Agung.",
  },
  {
    icon: 'waves',
    name: 'Kanto Lampo Waterfall',
    distance: '12 km',
    description: 'A beautiful multi-tier waterfall with easy access, perfect for photography and a refreshing dip.',
  },
  {
    icon: 'fort',
    name: 'Ubud Center',
    distance: '30 km',
    description: "Bali's cultural heart, known for its traditional crafts, dance, and the famous Monkey Forest.",
  },
  {
    icon: 'flight',
    name: 'Ngurah Rai Airport',
    distance: '53 km',
    description: "Bali's international gateway. We offer paid shuttle services to make your arrival and departure seamless.",
  },
];
---

<section class="py-20 px-6 md:px-12 bg-surface">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-14" data-aos="fade-up">
      <span class="text-primary uppercase tracking-[0.2em] text-xs font-semibold mb-3 block">
        What's Nearby
      </span>
      <h2 class="font-headline text-3xl md:text-4xl text-on-surface mb-4">
        Explore the Region
      </h2>
      <p class="text-on-surface-variant max-w-xl mx-auto text-base">
        Undisan sits at a natural crossroads — close to Bali's most sacred sites, yet far from the crowds.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {attractions.map((place, index) => (
        <div
          class="flex gap-4 items-start bg-surface-container-lowest rounded-xl p-6 shadow-sm border border-outline-variant/30"
          data-aos="fade-up"
          data-aos-delay={index * 100}
        >
          <div class="w-11 h-11 rounded-full bg-primary-container flex items-center justify-center shrink-0 mt-0.5">
            <span class="material-symbols-outlined text-on-primary-container text-xl font-light">
              {place.icon}
            </span>
          </div>
          <div>
            <div class="flex items-center gap-2 mb-1">
              <h3 class="font-headline text-base font-bold text-on-surface">{place.name}</h3>
              <span class="text-xs text-secondary font-label bg-surface-container-high px-2 py-0.5 rounded-full">
                {place.distance}
              </span>
            </div>
            <p class="text-sm text-on-surface-variant leading-relaxed">{place.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
