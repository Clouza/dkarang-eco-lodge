---

<section class="py-16 md:py-24 bg-surface">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <h2
      class="font-headline text-3xl md:text-4xl text-primary mb-8 md:mb-12 tracking-wide text-center"
      data-aos="fade-up"
    >
      Galeri D'karang Eco Lodge
    </h2>

    <!-- mobile: vertical stack -->
    <div class="flex flex-col gap-4 md:hidden">
      {images.map((image, index) => (
        <div
          class="relative rounded-xl overflow-hidden h-56 group"
          data-aos="fade-up"
          data-aos-delay={index * 80}
        >
          <img
            alt={image.alt}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            src={image.src}
          />
          {image.caption && (
            <div class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent flex items-end p-4">
              <h3 class="font-headline text-xl text-white">{image.caption}</h3>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- desktop: bento grid -->
    <div class="hidden md:grid md:grid-cols-3 gap-6 auto-rows-75">
      {images.map((image, index) => (
        <div
          class={`${image.colSpan} relative rounded-xl overflow-hidden group`}
          data-aos="zoom-in"
          data-aos-delay={index * 100}
        >
          <img
            alt={image.alt}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            src={image.src}
          />
          {image.caption && (
            <div class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent flex items-end p-6">
              <h3 class="font-headline text-2xl text-white">{image.caption}</h3>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
