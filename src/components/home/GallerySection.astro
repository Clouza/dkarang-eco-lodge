---
const images = Array.from({ length: 8 }, (_, i) => ({
  src: `/images/gallery/photo-${i + 1}.jpg`,
  alt: `D'Karang Eco Lodge — photo ${i + 1}`,
}));
---

<section class="py-16 md:py-24 bg-surface">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <h2
      class="font-headline text-3xl md:text-4xl text-primary mb-8 md:mb-12 tracking-wide text-center"
      data-aos="fade-up"
    >
      Gallery
    </h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
      {images.map((image, index) => (
        <div
          class={`relative rounded-xl overflow-hidden group bg-surface-container-highest flex items-center justify-center ${index === 0 || index === 5 ? 'col-span-2 row-span-2' : ''} aspect-square`}
          data-aos="zoom-in"
          data-aos-delay={index * 60}
        >
          {/* fallback text */}
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 z-0">
            <span class="material-symbols-outlined text-on-surface-variant text-3xl font-light">image</span>
            <p class="font-body text-xs text-on-surface-variant/60">Photo {index + 1}</p>
          </div>
          {/* image covers fallback when loaded */}
          <img
            alt={image.alt}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 z-10"
            src={image.src}
            onerror="this.style.display='none'"
          />
        </div>
      ))}
    </div>

    <div class="text-center mt-10" data-aos="fade-up">
      <a
        href="/gallery"
        class="inline-block border-2 border-primary text-primary font-label text-sm px-8 py-3 rounded-full hover:bg-primary hover:text-on-primary transition-colors"
      >
        View Full Gallery
      </a>
    </div>
  </div>
</section>
