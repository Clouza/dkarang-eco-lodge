---
const milestones = [
  {
    year: '2015',
    title: 'The Vision',
    description: 'Conception of an eco-friendly retreat that honors local architecture and minimizes environmental impact.',
  },
  {
    year: '2018',
    title: 'Breaking Ground',
    description: 'Construction begins using locally sourced, sustainable materials and traditional building techniques.',
  },
  {
    year: '2021',
    title: 'Opening Doors',
    description: "D'karang Eco Lodge officially opens, welcoming guests to experience harmony with nature.",
  },
];
---

<section class="py-24 bg-surface-container-low">
  <div class="max-w-7xl mx-auto px-4 md:px-12">
    <div class="text-center mb-16" data-aos="fade-up">
      <h2 class="font-headline text-4xl text-primary mb-4 tracking-wide">Our Heritage</h2>
      <p class="font-body text-on-surface-variant max-w-2xl mx-auto">
        The journey of building a sustainable sanctuary rooted in Balinese tradition.
      </p>
    </div>
    <div class="relative border-l-2 border-outline-variant ml-4 md:ml-8">
      {milestones.map((item, index) => (
        <div
          class={`pl-8 relative ${index < milestones.length - 1 ? 'mb-12' : ''}`}
          data-aos="fade-up"
          data-aos-delay={index * 150}
        >
          <div class="absolute w-4 h-4 bg-primary rounded-full -left-2.25 top-2 border-4 border-surface-container-low"></div>
          <div class="bg-surface-container-lowest p-6 rounded-xl shadow-md">
            <span class="font-label text-sm text-secondary mb-2 block">{item.year}</span>
            <h3 class="font-headline text-2xl text-on-surface mb-3">{item.title}</h3>
            <p class="font-body text-on-surface-variant">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
