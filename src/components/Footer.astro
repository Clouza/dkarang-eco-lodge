---
const footerLinks = [
  { label: 'Sustainability', href: '/contact' },
  { label: 'Careers', href: '/contact' },
  { label: 'Privacy Policy', href: '/contact' },
  { label: 'Terms of Service', href: '/contact' },
];
---

<footer class="w-full py-10 bg-surface-container-low border-t border-outline-variant/30">
  <div class="max-w-7xl mx-auto px-6 md:px-12 flex flex-col md:flex-row justify-between items-center gap-6">
    <div class="font-headline italic text-lg text-primary">D'karang Lodge</div>
    <div class="flex flex-wrap justify-center gap-4 md:gap-6 text-sm">
      {footerLinks.map((link) => (
        <a
          class="text-on-surface-variant hover:text-primary transition-colors"
          href={link.href}
        >
          {link.label}
        </a>
      ))}
    </div>
    <div class="text-xs text-on-surface-variant text-center md:text-right">
      &copy; 2026 D'karang Eco Lodge. All rights reserved.
    </div>
  </div>
</footer>
