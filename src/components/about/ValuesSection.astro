---
const values = [
  {
    icon: 'eco',
    title: 'Sustainable by Design',
    description:
      'Our structures utilize sustainably harvested bamboo, reclaimed teak, and locally sourced stone, minimizing our carbon footprint while maximizing natural beauty.',
    offset: false,
  },
  {
    icon: 'group',
    title: 'Community First',
    description:
      'We employ exclusively from Undisan and neighboring villages, ensuring that the economic benefits of tourism directly support the people who call this land home.',
    offset: true,
  },
  {
    icon: 'restaurant',
    title: 'Farm to Table',
    description:
      'Our kitchen relies on our own organic gardens and local farmers. We serve honest, vibrant Balinese cuisine that celebrates the seasonal bounty of the region.',
    offset: false,
  },
];
---

<section class="py-32 px-6 md:px-12 max-w-7xl mx-auto">
  <div class="text-center mb-20 max-w-3xl mx-auto" data-aos="fade-up">
    <span class="text-primary uppercase tracking-[0.2em] text-xs font-semibold mb-4 block">
      Our Philosophy
    </span>
    <h2 class="font-headline text-4xl md:text-5xl font-bold text-on-surface mb-6 tracking-tight">
      Treading Lightly
    </h2>
    <p class="text-on-surface-variant text-lg">
      We believe luxury and sustainability are not mutually exclusive. They are, in fact, essential
      to one another.
    </p>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {values.map((value, index) => (
      <div
        class={`bg-surface-container-lowest rounded-xl p-10 flex flex-col items-start gap-6 shadow-md ${value.offset ? 'md:mt-12' : ''}`}
        data-aos="fade-up"
        data-aos-delay={index * 150}
      >
        <div class="w-16 h-16 rounded-full bg-surface-container-high flex items-center justify-center text-primary">
          <span class="material-symbols-outlined text-3xl font-light">{value.icon}</span>
        </div>
        <h3 class="font-headline text-2xl font-bold text-on-surface">{value.title}</h3>
        <p class="text-on-surface-variant leading-relaxed">{value.description}</p>
      </div>
    ))}
  </div>
</section>
