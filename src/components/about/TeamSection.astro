<section class="py-24 bg-surface-container-low">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-8" data-aos="fade-up">
      <div class="max-w-2xl">
        <h2 class="font-headline text-4xl md:text-5xl font-bold text-on-surface mb-6 tracking-tight">
          Meet the Family
        </h2>
        <p class="text-on-surface-variant text-lg leading-relaxed">
          When you stay at D'karang, you are a guest in our home. Meet the dedicated individuals who
          bring our vision of authentic hospitality to life.
        </p>
      </div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-16">
      {team.map((member, index) => (
        <div class="group" data-aos="fade-up" data-aos-delay={index * 100}>
          <div class="relative w-full aspect-3/4 mb-6 overflow-hidden rounded-xl bg-surface-container-high">
            <img
              alt={member.alt}
              class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-700"
              src={member.src}
            />
          </div>
          <h4 class="font-headline text-xl font-bold text-on-surface mb-1">{member.name}</h4>
          <p class="text-primary text-sm uppercase tracking-wider mb-3">{member.role}</p>
        </div>
      ))}
    </div>
  </div>
</section>
